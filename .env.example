# Copy this file to .env and adjust the values. JobPilot reads it from the
# working directory. Environment variables take precedence over the file.

# --------------------------------------------------------------------- runtime
# development (default) or production. Production rejects wildcard CORS and
# expects explicit origins in JOBPILOT_CORS_ORIGINS.
# JOBPILOT_ENV=development

# DEBUG, INFO, WARNING, ERROR, or CRITICAL (default INFO).
# JOBPILOT_LOG_LEVEL=INFO

# --------------------------------------------------------------------- database
# SQLite only. The default URL stores data in ./jobpilot.db.
DB_URL=sqlite:///jobpilot.db

# ------------------------------------------------------------------------ AI
# offline (deterministic fallback, default) or openai_compatible.
# openai_compatible requires AI_API_KEY.
# AI_PROVIDER=offline
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=your-key-here  # SECRET: never commit a real key
# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT_SECONDS=60
# AI_MAX_TOKENS=2000
# AI_TEMPERATURE=0
# AI_RETRIES=2

# -------------------------------------------------------------------- matching
# Comma-separated key=value pairs; must sum to 1.0.
# MATCH_WEIGHTS=skill_match=0.40,experience_match=0.20,role_match=0.15,location_match=0.10,remote_match=0.10,salary_match=0.05
# MATCH_MINIMUM_SCORE=50

# -------------------------------------------------------------------- scraping
# SCRAPER_DEFAULT_RESULTS=50
# SCRAPER_FETCH_DESCRIPTIONS=true
# SCRAPER_COUNTRY=USA

# --------------------------------------------------------------- HTTP API (CORS)
# Comma-separated list of allowed origins. Defaults to * in development; an
# empty value disables the CORS middleware entirely.
# JOBPILOT_CORS_ORIGINS=*

# --------------------------------------------------------------- notifications
# NOTIFY_ENABLED=false
# NOTIFY_WEBHOOK_URL=